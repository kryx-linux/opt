# Description: A set of python bindings for cairo.
# URL: https://pypi.org/project/pycairo/
# Maintainer: Danny Rawlins, crux at romster dot me
# Depends on: cairo

name=python3-cairo
version=1.17.1
release=1
source=(https://github.com/pygobject/pycairo/releases/download/v$version/pycairo-$version.tar.gz)

build() {
	cd pycairo-$version

	/usr/bin/python3 setup.py build
	/usr/bin/python3 setup.py install --skip-build --root=$PKG --optimize=1

	local pyv="$(/usr/bin/python3 -c "import sys; print(sys.version_info[0], sys.version_info[1], sep='.');")"
	find $PKG/usr/lib/python$pyv/site-packages/ -maxdepth 1 -type f \
		-name "pycairo-$version-py$pyv.egg-info" -delete
}
