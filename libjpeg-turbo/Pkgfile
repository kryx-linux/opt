name=libjpeg-turbo
version=1.3.0
release=1
source=(http://downloads.sourceforge.net/libjpeg-turbo/libjpeg-turbo-1.3.0.tar.gz)

build() {
	cd $name-$version
	./configure --prefix=/usr --mandir=/usr/man --with-jpeg8 --disable-static
	make
	make DESTDIR=$PKG install
	rm -r $PKG/usr/share
}
