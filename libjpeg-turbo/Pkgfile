# Description: Library of JPEG support functions.
# URL: https://www.libjpeg-turbo.org/
# Maintainer: CRUX System Team, core-ports at crux dot nu
# Depends on: cmake nasm

name=libjpeg-turbo
version=2.1.2
release=1
source=(https://downloads.sourceforge.net/project/$name/$version/$name-$version.tar.gz)

build() {
	prt-get isinst ninja && PKGMK_LIBJPEGTURBO+=' -G ninja'
	cmake -S $name-$version -B build $PKGMK_LIBJPEGTURBO \
		-D CMAKE_BUILD_TYPE=Release \
		-D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_INSTALL_LIBDIR=/usr/lib \
		-D WITH_JPEG8=ON
	cmake --build build -j ${JOBS:-1}
	DESTDIR=$PKG cmake --install build
	rm -r $PKG/usr/share/doc
}
