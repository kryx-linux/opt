# Description: Virtual keyboard framework
# URL: https://www.qt.io/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: hunspell qt6-declarative qt6-svg

name=qt6-virtualkeyboard
version=6.9.0
release=1
source=(https://download.qt.io/official_releases/qt/${version%.*}/$version/submodules/qtvirtualkeyboard-everywhere-src-$version.tar.xz)

build() {
  prt-get isinst ccache && PKGMK_QT6+=' -D QT_USE_CCACHE=ON' && PATH="$(echo ${PATH} | awk -v RS=: -v ORS=: '/ccache/ {next} {print}' | sed 's/:*$//')"

  cmake -S qtvirtualkeyboard-everywhere-src-$version -B build -G Ninja $PKGMK_QT6 \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
    -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
    -Wno-dev
  cmake --build build
  DESTDIR=$PKG cmake --install build
}
