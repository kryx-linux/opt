# Description: An event-driven initramfs infrastructure
# URL: https://dracut.wiki.kernel.org/index.php/Main_Page
# Maintainer: Matt Housh, jaeger at crux dot ninja
# Depends on: asciidoc

name=dracut
version=057
release=1
source=(https://github.com/dracutdevs/$name/archive/$version/$name-$version.tar.gz)

build() {
	cd $name-$version
	./configure --prefix=/usr \
		--sysconfdir=/etc
	make
	make DESTDIR=$PKG install
	rm $PKG/usr/lib/$name/modules.d/*/README*
}
