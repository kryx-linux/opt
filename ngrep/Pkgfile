# Description: Network grep utility
# URL:         https://github.com/jpr5/ngrep
# Maintainer:  Juergen Daubert, jue at crux dot nu
# Depends on:  libpcap libpcre2

name=ngrep
version=1.48.3
release=1
source=(https://github.com/jpr5/ngrep/archive/refs/tags/v$version/$name-$version.tar.gz)

build () {
    cd $name-$version

    ./configure \
        --prefix=/usr \
        --enable-ipv6 \
        --enable-pcre2

    make
    make DESTDIR=$PKG install
}
