# Description: Network grep utility
# URL:         https://github.com/jpr5/ngrep
# Maintainer:  Juergen Daubert, jue at crux dot nu
# Depends on:  libpcap

name=ngrep
version=1.47
release=2
source=(https://github.com/jpr5/ngrep/archive/V${version//./_}/$name-$version.tar.gz
    $name-$version-clang16.patch $name-$version-regex.patch)

build () {
    cd $name-${version//./_}

    # patches from gentoo
    patch -p1 -i $SRC/$name-$version-clang16.patch
    patch -p1 -i $SRC/$name-$version-regex.patch

    autoreconf -i

    ./configure --prefix=/usr --enable-ipv6
    make
    make DESTDIR=$PKG install
}
