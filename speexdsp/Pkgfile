# Description: DSP library derived from speex
# URL: https://www.speex.org/
# Maintainer: Tim Biermann, tbier at posteo dot de

name=speexdsp
version=1.2.1
release=1
source=(https://gitlab.xiph.org/xiph/speexdsp/-/archive/SpeexDSP-$version/speexdsp-SpeexDSP-$version.tar.bz2)

build(){
  cd $name-SpeexDSP-$version

  NO_CONFIGURE=1 ./autogen.sh
  ./configure \
    --prefix=/usr

  sed -i -e '/^SUBDIRS *=/s|\bdoc\b||' Makefile

  make
  make DESTDIR=$PKG install
}
