# Description: Simple Authentication and Security Layer
# URL:         https://www.cyrusimap.org/sasl/
# Maintainer:  Thomas Penteker, tek at serverop dot de
# Depends on:  db openssl

name=cyrus-sasl
version=2.1.27
release=1
source=(https://www.cyrusimap.org/releases/$name-$version.tar.gz saslauthd)

build(){
  cd $name-$version

  ./configure \
      --prefix=/usr \
      --sysconfdir=/etc/sasl \
      --with-plugindir=/usr/lib/sasl2 \
      --with-saslauthd=/var/sasl/saslauthd \
      --with-dbpath=/etc/sasl/sasldb2 \
      --with-dblib=berkeley \
      --with-bdb-incdir=/usr/include \
      --with-bdb-libdir=/usr/lib \
      --with-openssl=/usr \
      --enable-login \
      --enable-cram \
      --enable-digest \
      --enable-shared

  make
  make DESTDIR=$PKG install

  mkdir -p \
      $PKG/usr/lib/sasl2 \
      $PKG/var/sasl/saslauthd \
      $PKG/etc/rc.d

  install -m 755 $SRC/saslauthd $PKG/etc/rc.d
}
