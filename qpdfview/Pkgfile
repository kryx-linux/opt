# Description: PDF viewer
# URL: https://launchpad.net/qpdfview
# Maintainer: Juergen Daubert, jue at crux dot nu
# Depends on: poppler-qt6 qt6-svg

name=qpdfview
version=0.5.0beta1
release=1
source=(https://launchpad.net/qpdfview/trunk/$version/+download/$name-$version.tar.gz)

build () {
	cd $name-$version

	prt-get isinst cups || PKGMK_QPDFVIEW+='without_cups '
	prt-get isinst libspectre || PKGMK_QPDFVIEW+='without_ps '
	prt-get isinst djvulibre || PKGMK_QPDFVIEW+='without_djvu '

	qmake-qt6 qpdfview.pro \
		MANUAL_INSTALL_PATH=/usr/share/man/man1 \
		CONFIG+="$PKGMK_QPDFVIEW"

	make
	make INSTALL_ROOT=$PKG install

	rm $PKG/usr/share/qpdfview/help_*.html
}
