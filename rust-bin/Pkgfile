name=rust-bin
version=1.52.1
release=1
source=(https://crux.ster.zone/downloads/rust/rust-$version-$release-crux-3.6-bin.tar.xz)

build() {
	cp -a $SRC/usr $SRC/etc $PKG/
	mv $PKG/etc/revdep.d/rust $PKG/etc/revdep.d/rust-bin
}
