name=jdk
version=1.6.0_25
release=1
source=(http://download.java.net/dlj/binaries/$name-6u${version/*_/}-dlj-linux-i586.bin)

build(){
	mkdir -p $PKG/usr/lib && cd $PKG/usr/lib
	sh $SRC/jdk-*.bin --accept-license --unpack

	rm -rf jdk*/{man/ja,jre/lib/javaws/messages_,demo,sample}*
	rm -rf jdk*/jre/lib/fontconfig.{RedHat,SuSE,Sun,Turbo}.*
	rm -rf jdk*/jre/plugin/i386/ns7-gcc29
	rm -rf jdk*/jre/.systemPrefs
	rm $PKG/usr/lib/jdk$version/{,jre/}[A-Z]*
	mv jdk$version/man $PKG/usr

	export GLOBIGNORE="*/src.zip"
	for i in jdk*/* jdk*/jre/*; do
	  test -f $i && rm -rf $i;
	done
	
	ln -s jdk* java

	# generate classes.jsa
	cd java
	./bin/java -server -Xshare:dump
	./bin/java -client -Xshare:dump
	cd ..

	mkdir -p $PKG/usr/bin && cd $PKG/usr/bin
	for j in java javac javah javap javaws jar keytool; do
		ln -s ../lib/java/bin/$j
	done

}
