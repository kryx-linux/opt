# Description: Adobe Flash plugin for the chromium browser
# URL:         http://chromium.org/
# Maintainer:  Thomas Penteker, tek at serverop dot de
# Depends on:  chromium

name=chromium-pepperflash
version=27.0.0.130
release=1
source=()

build() {

  wget https://fpdownload.adobe.com/get/flashplayer/pdc/$version/flash_player_ppapi_linux.x86_64.tar.gz
  tar -xzf flash_player_ppapi_linux.x86_64.tar.gz
  install -Dm644 manifest.json libpepflashplayer.so -t $PKG/usr/lib/PepperFlash/

}
