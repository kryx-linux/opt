# Description: Java 2 Runtime Kit
# URL:         http://java.sun.com
# Maintainer:  Juergen Daubert, jue at crux dot nu
# Packager:    Simone Rota, sip at crux dot nu

name=jre
version=1.6.0_23
release=2
source=(file:///jre-6u23-linux-i586.bin)

build(){
    sh $SRC/jre-*.bin --accept-license --unpack

    install -d $PKG/usr/{bin,lib}
    mv jre$version $PKG/usr/lib
    mv $PKG/usr/lib/jre$version/man $PKG/usr

    ln -s jre$version $PKG/usr/lib/java
    ln -s ../lib/java/bin/java $PKG/usr/bin/java
    ln -s ../lib/java/bin/javaws $PKG/usr/bin/javaws
    ln -s ../lib/java/bin/keytool $PKG/usr/bin/keytool

    rm $PKG/usr/lib/jre$version/[A-Z]*
    rm -r $PKG/usr/lib/jre$version/.systemPrefs
    rm -r $PKG/usr/man/ja*
}
