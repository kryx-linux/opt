# Description: Provides access to sensor hardware and motion gesture recognition
# URL: https://www.qt.io/
# Maintainer: Danny Rawlins, crux at romster dot me
# Depends on: qt6-connectivity

name=qt6-sensors
version=6.2.2
release=1
source=(https://download.qt.io/official_releases/qt/${version%.*}/$version/submodules/qtsensors-everywhere-src-$version.tar.xz)

build() {
	prt-get isinst ninja && PKGMK_QT6+=' -G Ninja'
	prt-get isinst ccache && PKGMK_QT6+=' -D QT_USE_CCACHE=ON' && PATH="$(echo ${PATH} | awk -v RS=: -v ORS=: '/ccache/ {next} {print}' | sed 's/:*$//')"

	cmake -S qtsensors-everywhere-src-$version -B build $PKGMK_QT6 \
		-D INSTALL_PUBLICBINDIR=usr/bin \
		-D CMAKE_BUILD_TYPE=Release \
		-D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-D CMAKE_C_FLAGS_RELEASE="$CFLAGS"
	cmake --build build
	DESTDIR=$PKG cmake --install build
}
