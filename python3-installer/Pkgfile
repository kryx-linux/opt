# Description: A low-level library for installing from a Python wheel distribution
# URL: https://github.com/pypa/installer
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-flit-core

name=python3-installer
version=1.0.0
release=2
source=(https://pypi.org/packages/source/i/installer/installer-$version.tar.gz
  b5f03f151f0edbf43dd5793e2d6f1c94f7d3d408.patch
  8b72cf945bfa72295fe4e0e8b9ddc13f8df32964.patch)

build() {
  cd installer-$version

  patch -Np1 -i $SRC/b5f03f151f0edbf43dd5793e2d6f1c94f7d3d408.patch
  patch -Np1 -i $SRC/8b72cf945bfa72295fe4e0e8b9ddc13f8df32964.patch

  /usr/bin/python3 -m flit_core.wheel

  _pyver=$(/usr/bin/python3 -c 'import sys; print("%s.%s" % sys.version_info[:2])')
  mkdir -p $PKG/usr/lib/python${_pyver}/site-packages
  /usr/bin/python3 -c "import zipfile, sys; zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])" dist/*.whl $PKG/usr/lib/python${_pyver}/site-packages
  /usr/bin/python3 -m compileall -d /usr/lib $PKG
  /usr/bin/python3 -O -m compileall -d /usr/lib $PKG
  /usr/bin/python3 -OO -m compileall -d /usr/lib $PKG
}
