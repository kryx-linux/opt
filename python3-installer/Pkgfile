# Description: A low-level library for installing from a Python wheel distribution
# URL: https://github.com/pypa/installer
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-pip
# Optional: python3-flit-core

name=python3-installer
version=0.5.1
release=1
source=(https://pypi.org/packages/source/i/installer/installer-$version.tar.gz)

build() {
  cd installer-$version

  _pyver=$(/usr/bin/python3 -c 'import sys; print("%s.%s" % sys.version_info[:2])')

  if prt-get isinst python3-flit-core; then
    /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
    /usr/bin/python3 -m installer --compile-bytecode 0 --destdir=$PKG dist/*.whl
  else
    /usr/bin/pip3 install --isolate --root=$PKG --ignore-installed --no-deps installer
  fi

  rm -rf $PKG/usr/lib/python$_pyver/site-packages/installer-$version.dist-info/{INSTALLER,REQUESTED}
}
