# Description: GNU EFI library
# URL: https://github.com/ncroxon/gnu-efi
# Maintainer: CRUX System Team, core-ports at crux dot nu

name=gnu-efi
version=4.0.0
release=1
source=(https://github.com/ncroxon/gnu-efi/archive/$version/$name-$version.tar.gz)

build() {
	cd $name-$version
	make
	make INSTALLROOT=$PKG PREFIX=/usr install
}
