+void QDBusConnectionPrivate::timerEvent(QTimerEvent *e)
+{
+    {
+        QDBusWatchAndTimeoutLocker locker(TimerEventAction, this);
+        DBusTimeout *timeout = timeouts.value(e->timerId(), 0);
+        if (timeout)
+            q_dbus_timeout_handle(timeout);
+    }
+
+    doDispatch();
