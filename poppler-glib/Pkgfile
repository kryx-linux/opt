# Description: glib wrapper for poppler
# URL:         http://poppler.freedesktop.org/
# Maintainer:  Juergen Daubert, jue at crux dot nu
# Depends on:  gobject-introspection poppler 

name=poppler-glib
version=0.58.0
release=1
source=(http://poppler.freedesktop.org/poppler-$version.tar.xz
        poppler-cmake.patch)

build() {
    cd poppler-$version

    patch -p0 -i $SRC/poppler-cmake.patch

    cmake . \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DENABLE_XPDF_HEADERS=OFF \
        -DENABLE_UTILS=OFF \
        -DENABLE_SPLASH=ON \
        -DENABLE_CAIRO=ON \
        -DENABLE_CPP=OFF \
        -DENABLE_GLIB=ON \
        -DENABLE_QT4=OFF \
        -DENABLE_QT5=OFF \
        -DENABLE_ZLIB=ON \
        -DENABLE_CMS=lcms2 \
        -DENABLE_LIBOPENJPEG=none \
        -DENABLE_NSS3=OFF \
        -DBUILD_GTK_TESTS=OFF \
        -DBUILD_QT4_TESTS=OFF \
        -DBUILD_QT5_TESTS=OFF \
        -DBUILD_CPP_TESTS=OFF \

    make
    make DESTDIR=$PKG install

    rm $PKG/usr/lib/libpoppler.so*
    rm $PKG/usr/lib/pkgconfig/poppler.pc
    rm $PKG/usr/lib/pkgconfig/poppler-splash.pc
    rm $PKG/usr/lib/pkgconfig/poppler-cairo.pc
}
