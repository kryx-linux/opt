# Description: Character encoding for the web.
# URL: https://github.com/gsnedders/python-webencodings
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-wheel

name=python3-webencodings
version=0.6.1
release=1
source=(https://pypi.org/packages/source/w/webencodings/webencodings-$version.tar.gz)

build() {
  cd webencodings-$version

  /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
