# Description: RSS/Atom feed reader for text terminals
# URL: http://www.newsboat.org/
# Maintainer: Juergen Daubert, jue at crux dot nu
# Depends on: curl libxml2 sqlite3 stfl json-c rust
# Optional: asciidoctor

name=newsboat
version=2.35
release=1
source=(https://newsboat.org/releases/$version/$name-$version.tar.xz)

build () {
	cd $name-$version

	sed "s/-O2 -ggdb/$CXXFLAGS/" -i Makefile
	export prefix=/usr
	./config.sh
	make newsboat podboat
	make DESTDIR=$PKG install-{news,pod}boat

	if prt-get isinst asciidoctor; then
		make DESTDIR=$PKG install-docs
		rm -r $PKG/usr/share/doc
	fi
}
