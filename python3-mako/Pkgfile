# Description: A template library written in Python
# URL: https://www.makotemplates.org/
# Maintainer: CRUX System Team, core-ports at crux dot nu
# Depends on: python3-markupsafe python3-wheel

name=python3-mako
version=1.3.11
release=1
source=(https://pypi.org/packages/source/m/mako/mako-$version.tar.gz)

build() {
    cd mako-$version

    /usr/bin/python3 -m build --wheel --skip-dependency-check --no-isolation
    /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
