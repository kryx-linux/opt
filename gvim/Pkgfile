# Description: GTK version of the vim editor
# URL:         http://www.vim.org/
# Maintainer:  Juergen Daubert, jue at crux dot nu
# Depends on:  vim, gtk, xorg-libxt

name=gvim
version=8.0.586
release=1
source=(ftp://ftp.vim.org/pub/vim/unix/vim-$version.tar.bz2)

build () {
    cd vim80/src

    sed -i '/^CFLAGS/d' Makefile

    ./configure --prefix=/usr \
                --with-vim-name=gvim \
                --with-x=yes \
                --enable-gui=gtk2 \
                --enable-multibyte \
                --enable-cscope \
                --disable-gpm \
                --disable-nls

    make VIMRTDIR=
    make VIMRTDIR= DESTDIR=$PKG installvimbin install-icons

    sed -ri '/\[.+\]=/d' $PKG/usr/share/applications/*.desktop
}
