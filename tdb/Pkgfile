# Description:	Trivial DataBase similar to gdbm
# URL:		http://tdb.samba.org/
# Maintainer:	Alan Mizrahi, alan at mizrahi dot com dot ve
# Packager:	Juergen Daubert, jue at crux dot nu
# Depends on:	attr python

name=tdb
version=1.3.10
release=1
source=(
http://www.samba.org/ftp/$name/$name-$version.tar.gz
$name-$version-man-pages.tar.xz
)

build() {
	cd $name-$version
	./configure \
		--prefix=/usr
	make
	make DESTDIR=$PKG install
	install -d $PKG/usr/share/man/man8
	install -m 0644 $SRC/*.8 $PKG/usr/share/man/man8
}
