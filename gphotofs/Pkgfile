# Description: FUSE filesystem client based on libgphoto2
# URL:         http://www.gphoto.org
# Maintainer:  Juergen Daubert, jue at crux dot nu
# Depends on:  fuse3, glib, libgphoto2

name=gphotofs
version=1.0
release=1
source=(https://github.com/gphoto/gphotofs/releases/download/v$version/$name-$version.tar.bz2)

build() {
    cd $name-$version
    ./configure --prefix=/usr
    make
    make DESTDIR=$PKG install
}
