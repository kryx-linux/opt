# Depends on:   setuptools

name=pip
version=9.0.1
release=1
source=(https://pypi.io/packages/source/p/pip/pip-${version}.tar.gz)

build() {
    cd $name-$version
    /usr/bin/python setup.py install --prefix=/usr --root=$PKG
}
