name=libcgroup
version=0.41
release=1
source=(http://download.sourceforge.net/project/libcg/$name/v${version}/${name}-${version}.tar.bz2)

build() {
  cd $name-$version

  ./configure --prefix=/usr \
              --disable-pam

  make
  make DESTDIR=$PKG install
}
