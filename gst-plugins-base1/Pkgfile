# Description: An essential exemplary set of plugins for gstreamer.
# URL: http://gstreamer.freedesktop.org/modules/gst-plugins-base.html
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Packager: Matt Housh, jaeger at morpheus dot net
# Depends on: alsa-lib cdparanoia gstreamer1 libtheora libvisual orc pango util-linux xorg-libxv

name=gst-plugins-base1
version=1.0.10
release=2
source=(http://gstreamer.freedesktop.org/src/gst-plugins-base/gst-plugins-base-$version.tar.xz)

build() {
	cd gst-plugins-base-$version

	./configure \
		--prefix=/usr \
		--mandir=/usr/man \
		--enable-orc \
		--disable-debug \
		--disable-nls \
		--disable-dependency-tracking \
		--disable-valgrind \
		--disable-examples \
		--disable-gtk-doc-html

	make
	make DESTDIR=$PKG install
	rm -r $PKG/usr/share/gtk-doc
}
