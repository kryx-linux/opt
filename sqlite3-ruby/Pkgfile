# Description: Interface to the SQLite DB engine
# URL:         http://rubygems.org/gems/sqlite3/
# Maintainer:  Juergen Daubert, jue at crux dot nu
# Depends on:  ruby, sqlite3

name=sqlite3-ruby
version=1.3.11
release=1
source=(http://rubygems.org/downloads/sqlite3-$version.gem)

build() {
   
    bsdtar -x -f sqlite3-$version.gem
    bsdtar -x -f data.tar.gz

    ruby setup.rb config
    ruby setup.rb setup
    ruby setup.rb install --prefix=$PKG
    
    mv $PKG/usr/lib/ruby/{site,vendor}_ruby
}
