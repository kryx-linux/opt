# Description: Interface to the SQLite DB engine
# URL:         http://rubygems.org/gems/sqlite3-ruby/
# Maintainer:  Juergen Daubert, jue at crux dot nu
# Depends on:  ruby, sqlite3

name=sqlite3-ruby
version=1.3.7
release=1
source=(http://crux.s3.amazonaws.com/dist/$name-$version.tar.xz)

build() {
    cd $name-$version
    
    ruby setup.rb config
    ruby setup.rb setup
    ruby setup.rb install --prefix=$PKG
    
    mv $PKG/usr/lib/ruby/{site_ruby,vendor_ruby}
}
