# Description: A tool for installing and managing Python packages.
# URL: https://www.pip-installer.org/
# Maintainer: Danny Rawlins, crux at romster dot me
# Depends on: python

name=pip
version=9.0.1
release=2
source=(https://pypi.io/packages/source/p/pip/pip-$version.tar.gz
	https://bootstrap.pypa.io/get-pip.py)

build() {
	cd $name-$version

	if [ "$(pkginfo -i | egrep -c '^(setuptools|appdirs|pyparsing|six|pip|packaging) ')" != 6 ]; then
		install -d build
		/usr/bin/python $SRC/get-pip.py --root=$SRC/build

		PYTHONPATH=$SRC/build/usr/lib/python2.7/site-packages \
			/usr/bin/python setup.py build

		PYTHONPATH=$SRC/build/usr/lib/python2.7/site-packages \
			/usr/bin/python setup.py install \
			--prefix=/usr --root=$PKG --optimize=1
	else
		/usr/bin/python setup.py build

		/usr/bin/python setup.py install \
			--prefix=/usr --root=$PKG --optimize=1
	fi
}
