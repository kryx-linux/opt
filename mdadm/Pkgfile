# Description: Multiple device (RAID) admin tool
# URL: http://neil.brown.name/blog/mdadm
# Maintainer: Juergen Daubert, jue at crux dot nu

name=mdadm
version=4.4
release=1
source=(https://git.kernel.org/pub/scm/utils/mdadm/mdadm.git/snapshot/$name-$version.tar.gz
    $name-4.3-in_initrd-collision.patch)

build() {
    cd $name-$version

    # From gentoo
    patch -p1 -i $SRC/$name-4.3-in_initrd-collision.patch

    make all mdadm.static
    make DESTDIR=$PKG install
    install -m0755 mdadm.static $PKG/sbin
}
