# Description: Mozilla's JavaScript engine
# URL:         https://developer.mozilla.org/en-US/docs/Mozilla/Projects/SpiderMonkey
# Maintainer:  Juergen Daubert, jue at crux dot nu
# Depends on:  autoconf-2.13 readline zlib nspr python3 rust

name=mozjs78
version=78.7.1
release=1
source=(https://archive.mozilla.org/pub/firefox/releases/${version}esr/source/firefox-${version}esr.source.tar.xz
	rust-1.5.0-build.patch)

build() {
	cd firefox-$version

	# https://bugzilla.mozilla.org/show_bug.cgi?id=1684261
	patch -p1 -i $SRC/rust-1.5.0-build.patch

	export CC=gcc CXX=g++

	mkdir obj ; cd obj
	../js/src/configure \
		--prefix=/usr \
		--disable-jemalloc \
		--disable-debug-symbols \
		--disable-optimize \
		--enable-readline \
		--with-intl-api \
		--with-system-nspr \
		--with-system-zlib

	make
	make DESTDIR=$PKG install

	rm $PKG/usr/lib/libjs_static.ajs
	chmod -x $PKG/usr/lib/pkgconfig/*
}
