# Description: Protocol definitions and daemon for D-Bus at-spi
# URL: https://gitlab.gnome.org/GNOME/at-spi2-core
# Maintainer: CRUX System Team, core-ports at crux dot nu
# Depends on: dbus glib-introspection intltool xorg-libxtst

name=at-spi2-core
version=2.62.0.1
release=1
source=(https://gitlab.gnome.org/GNOME/at-spi2-core/-/archive/$version/at-spi2-core-$version.tar.bz2)

build() {
    meson setup build $name-$version \
        --prefix /usr \
        --sysconfdir=/usr/etc \
        --libexecdir=/usr/lib/at-spi2 \
        --buildtype=plain \
        --wrap-mode nodownload \
        -D b_lto=true \
        -D b_pie=true \
        -D gtk2_atk_adaptor=false

    meson compile -C build -j ${JOBS:-1}
    DESTDIR=$PKG meson install -C build

    rm -r $PKG/usr/{share/locale,lib/systemd}
}
