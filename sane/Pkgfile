# Description: Scanner Access Now Easy - Scanner driver for Linux
# URL: http://www.sane-project.org/
# Maintainer: Juergen Daubert, jue at crux dot nu
# Depends on: libusb libtiff libpng zstd

name=sane
version=1.4.0
release=1
source=(https://gitlab.com/-/project/429008/uploads/843c156420e211859e974f78f64c3ea3/sane-backends-$version.tar.gz)

build() {
    cd $name-backends-$version

    ./configure \
        --prefix=/usr \
        --localstatedir=/var \
        --sysconfdir=/etc \
        --disable-translations \
        --disable-locking \
        --disable-latex \
        --with-group=scanner \
        --with-usb

    make
    make -j1 DESTDIR=$PKG install

    install -D -m 644 tools/udev/libsane.rules $PKG/etc/udev/rules.d/85-libsane.rules

    rm -r $PKG/usr/share/{doc,locale}
}
