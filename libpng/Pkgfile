# Description: Library of PNG support functions with APNG support
# URL: https://libpng.org/pub/png/
# Maintainer: CRUX System Team, core-ports at crux dot nu
# Depends on: zlib

name=libpng
version=1.6.59
release=1
source=(https://github.com/pnggroup/libpng/archive/v$version/$name-$version.tar.gz
    libpng-1.6.57-apng-v2.patch)

build() {
    patch -Np1 -d $name-$version -i $SRC/libpng-1.6.57-apng-v2.patch

    cmake -S $name-$version -B build -G Ninja \
      -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_INSTALL_LIBDIR=lib \
      -D CMAKE_BUILD_TYPE=Release \
      -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
      -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
      -Wno-dev
    cmake --build build
    DESTDIR=$PKG cmake --install build
}
