# Description: Library of PNG support functions.
# URL:         http://www.libpng.org
# Maintainer:  Fredrik Rinnestam, fredrik at crux dot nu
# Depends on:  zlib

name=libpng
version=1.5.14
release=1
source=(http://download.sourceforge.net/$name/$name-$version.tar.xz \
        http://downloads.sourceforge.net/project/libpng-apng/libpng15/1.5.13/$name-1.5.13-apng.patch.gz)

build() {
    cd $name-$version
    zcat $SRC/$name-1.5.13-apng.patch.gz | patch -p1
    ./configure --prefix=/usr --mandir=/usr/man

    make
    make DESTDIR=$PKG install
}
