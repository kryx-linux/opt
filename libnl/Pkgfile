# Description: Library providing APIs to netlink protocol based Linux kernel interfaces
# URL:         http://www.infradead.org/~tgr/libnl/
# Maintainer:  Juergen Daubert, jue at crux dot nu

name=libnl
version=1.1
release=1
source=(http://www.infradead.org/~tgr/$name/files/$name-$version.tar.gz
        $name-$version-fix_port_tracking.patch 
        $name-$version-limits.patch
        $name-$version-remove_inline_specifier.patch)

build()
{
    cd $name-$version
    
    patch -p1 -i $SRC/$name-$version-limits.patch
    patch -p1 -i $SRC/$name-$version-fix_port_tracking.patch
    patch -p1 -i $SRC/$name-$version-remove_inline_specifier.patch

    ./configure --prefix=/usr
    make
    make DESTDIR=$PKG install
}
