# Description: Backends and filters for CUPS
# URL:         http://www.linuxfoundation.org/collaborate/workgroups/openprinting/pdfasstandardprintjobformat
# Maintainer:  Juergen Daubert, jue at crux dot nu
# Depends on:  cups poppler qpdf

name=cups-filters
version=1.0.30
release=1
source=(http://www.openprinting.org/download/$name/$name-$version.tar.xz
        $name-build_without_avahi.patch)

build () {
    cd $name-$version

    patch -p0 -i $SRC/$name-build_without_avahi.patch

    autoconf
    ./configure --prefix=/usr \
                --sysconfdir=/etc \
                --mandir=/usr/man \
                --without-php \
                --disable-avahi \
                --with-browseremoteprotocols=none

    make
    make DESTDIR=$PKG install

    rm -r $PKG/{usr/share/doc,etc/cups}
}
