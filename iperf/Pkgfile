name=iperf
version=2.0.5
release=1
source=(http://prdownloads.sf.net/$name/$name-$version.tar.gz)

build() {
	cd $name-$version
	./configure \
		--prefix=/usr \
		--mandir=/usr/man
	make
	make DESTDIR=$PKG install
}

