# Description: Core utilities for Python packages.
# URL: https://pypi.python.org/pypi/packaging/
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: python3-pyproject-hooks

name=python3-packaging
version=25.0
release=2
source=(https://pypi.org/packages/source/p/packaging/packaging-$version.tar.gz)

build() {
  cd packaging-$version

  /usr/bin/python3 -m flit_core.wheel
  /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}
