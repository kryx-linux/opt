# Description: qt5 wrapper for poppler
# URL:         http://poppler.freedesktop.org/
# Maintainer:  Juergen Daubert, jue at crux dot nu
# Depends on:  qt5 poppler 

name=poppler-qt5
version=0.54.0
release=1
source=(http://poppler.freedesktop.org/poppler-$version.tar.xz
        poppler-cmake.patch)

build() {
    cd poppler-$version

    patch -p0 -i $SRC/poppler-cmake.patch
    sed -i '/demos/d' qt5/CMakeLists.txt

    cmake . \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DENABLE_XPDF_HEADERS=OFF \
        -DENABLE_UTILS=OFF \
        -DENABLE_SPLASH=ON \
        -DENABLE_CAIRO=OFF \
        -DENABLE_CPP=OFF \
        -DENABLE_GLIB=OFF \
        -DENABLE_QT4=OFF \
        -DENABLE_QT5=ON \
        -DENABLE_ZLIB=ON \
        -DENABLE_CMS=lcms2 \
        -DENABLE_LIBOPENJPEG=OFF \
        -DENABLE_NSS3=OFF \
        -DBUILD_GTK_TESTS=OFF \
        -DBUILD_QT4_TESTS=OFF \
        -DBUILD_QT5_TESTS=OFF \
        -DBUILD_CPP_TESTS=OFF

    make
    make DESTDIR=$PKG install

    rm $PKG/usr/lib/libpoppler.so*
    rm $PKG/usr/lib/pkgconfig/poppler.pc
    rm $PKG/usr/lib/pkgconfig/poppler-splash.pc
}
