# Description: ngtcp2 project is an effort to implement IETF QUIC protocol
# URL: https://github.com/ngtcp2/ngtcp2
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: gnutls
# Optional: brotli libev libnghttp3

name=libngtcp2
version=1.10.0
release=1
source=(https://github.com/ngtcp2/ngtcp2/releases/download/v$version/ngtcp2-$version.tar.xz)

build() {
  cd ngtcp2-$version

  prt-get isinst brotli && PKGMK_NGTCP2+=' --with-libbrotlienc --with-libbrotlidec'
  autoreconf -fvi
  ./configure --prefix=/usr \
    --enable-lib-only \
    --with-gnutls
  make
  make DESTDIR=$PKG install

  rm -r $PKG/usr/share
}
