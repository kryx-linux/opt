# Description: Simplistic port-like solution for developers.
# URL: https://github.com/flavorjones/mini_portile
# Maintainer: Juergen Daubert, jue at crux dot nu
# Depends on: ruby

name=ruby-mini_portile2
version=2.8.8
release=1
source=(https://rubygems.org/downloads/mini_portile2-$version.gem)

build() {
    gem install mini_portile2 \
        --ignore-dependencies \
        --no-user-install \
        --no-document \
        --local \
        --build-root $PKG

    cd $PKG/$(gem env gemdir)
    rm -r cache doc build_info
    cd gems/mini_portile2-$version
    rm -r .github
    find -maxdepth 1 -type f -delete
}

