# Description: Curses based spreadsheet with vi key-bindings
# URL: https://github.com/n-t-roff/sc
# Maintainer: Juergen Daubert, jue at crux dot nu
# Depends on: ncurses

name=sc
version=7.16-1.2.0
release=1
source=(https://github.com/n-t-roff/sc/archive/refs/tags/${version/-/_}/$name-$version.tar.gz)

build() {
    cd $name-${version/-/_}

    ./configure
    make
    make prefix=$PKG/usr install
}
