# Description: (un)zip based on zlib
# URL: https://www.zlib.net/
# Maintainer: Tim Biermann, tbier at posteo dot de

name=minizip
version=1.3.2
release=2
source=(https://zlib.net/fossils/zlib-$version.tar.gz
  36ff1be48ef696cc67b0855f7c8537ce0276210d.patch)

build() {
  cd zlib-$version/contrib/minizip

  patch -Np3 -i $SRC/36ff1be48ef696cc67b0855f7c8537ce0276210d.patch

  cp Makefile Makefile.orig
  cp ../README.contrib readme.txt

  autoreconf --install

  ./configure --prefix=/usr \
    --enable-static=no
  make
  make DESTDIR=$PKG install

  rm $PKG/usr/include/minizip/crypt.h
}
