# Description: Dynamic, any to any, pixel format translation library
# URL: https://gegl.org/babl
# Maintainer: Tim Biermann, tbier at posteo dot de
# Depends on: gobject-introspection lcms2
# Optional: vala

name=babl
version=0.1.114
release=1
source=(https://gitlab.gnome.org/GNOME/babl/-/archive/BABL_${version//./_}/babl-BABL_${version//./_}.tar.bz2)

build() {
  sed "s!@BABL_GIT_VERSION@!$version!g" ${name}-BABL_${version//./_}/git-version.h.in > ${name}-BABL_${version//./_}/git-version.h

  meson setup build ${name}-BABL_${version//./_} \
    --prefix=/usr \
    --buildtype=plain \
    --wrap-mode nodownload \
    -D b_lto=true \
    -D b_pie=true \
    -D with-docs=false \
    -D gi-docgen=disabled
  meson compile -C build -j ${JOBS:-1}
  DESTDIR=$PKG meson install -C build
}
