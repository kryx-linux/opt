# Description: text mode web browser
# URL: http://links.twibright.com/
# Maintainer: Juergen Daubert, jue at crux dot nu
# Depends on: bzip2 libevent zstd

name=links
version=2.30
release=2
source=(http://links.twibright.com/download/links-$version.tar.bz2
    0001-fix-build-with-recent-gcc.patch)

build() {
    cd $name-$version

    patch -p1 -i $SRC/0001-fix-build-with-recent-gcc.patch

    CFLAGS="$CFLAGS -Wno-error=implicit-int" \
    ./configure \
        --prefix=/usr \
        --mandir=/usr/share/man

    make
    make DESTDIR=$PKG install
}
