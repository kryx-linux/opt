name=distribute
version=1.4
release=1
source=(https://pypi.python.org/packages/source/s/setuptools/setuptools-1.4.tar.gz)

build() {
	cd setuptools-$version

	python setup.py install --root=$PKG

	chmod -R og-w $PKG
}
