# Description: Javascript engine library
# URL:         https://developer.mozilla.org/en-US/docs/Mozilla/Projects/SpiderMonkey
# Maintainer:  Alan Mizrahi, alan at mizrahi dot com dot ve
# Depends on:  autoconf-2.13 readline zlib nspr python

name=spidermonkey
version=60.9.0
release=1
source=(https://archive.mozilla.org/pub/firefox/releases/${version}esr/source/firefox-${version}esr.source.tar.xz)

build() {
	cd firefox-$version

	mkdir obj ; cd obj

	../js/src/configure \
		--prefix=/usr \
		--disable-jemalloc \
		--disable-optimize \
		--enable-readline \
		--with-intl-api \
		--with-system-nspr \
		--with-system-zlib

	make
	make DESTDIR=$PKG install

	rm $PKG/usr/lib/libjs_static.ajs
	chmod -x $PKG/usr/lib/pkgconfig/*
}
