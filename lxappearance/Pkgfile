# Description: Enables change of themes, icons, and fonts used by applications easily. 
# URL: https://wiki.lxde.org/en/LXAppearance
# Maintainer: Juergen Daubert, jue at crux dot nu
# Depends on: gtk3 intltool

name=lxappearance
version=0.6.4
release=1
source=(https://github.com/lxde/lxappearance/archive/refs/tags/$version/$name-$version.tar.gz)

build() {
	cd $name-$version

	export LINGUAS=" "

	./autogen.sh
	./configure \
		--prefix=/usr \
		--sysconfdir=/etc \
		--disable-nls \
		--enable-gtk3

	make
	make DESTDIR=$PKG install
}
