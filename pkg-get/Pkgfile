# Description: Package management tool for CRUX
# URL: https://git.crux.nu/tools/pkg-get/
# Maintainer: John McQuah, jmcquah at disroot dot org
# Depends on: 

name=pkg-get
version=0.5.0
release=1
source=(https://git.crux.nu/tools/$name/archive/release-$version.tar.gz)
renames=($name-$version.tar.gz)

build() {
    mkdir -p "$PKG"/usr/bin "$PKG"/usr/share/man/man8
    cp $name/doc/*.8 "$PKG"/usr/share/man/man8/
    for _p in $name/scripts/*.pl; do
        install -m 0755 "$_p" "$PKG"/usr/bin/$(basename "$_p" .pl)
    done
    install -D -m 644 $name/doc/$name.conf "$PKG"/etc/$name.conf
    install -D -m 644 $name/doc/style.html "$PKG"/usr/share/$name/style.html
}
